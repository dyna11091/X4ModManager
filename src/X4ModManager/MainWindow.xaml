<Window x:Class="X4ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:X4ModManager"
        xmlns:models="clr-namespace:X4ModManager.Core.Models;assembly=X4ModManager.Core"
        Title="X4 mod管理器" Width="1280" Height="790" MinWidth="1040" MinHeight="650"
        Icon="Assets/X4ModManager.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        BorderBrush="{DynamicResource OuterBorder}" BorderThickness="1">
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarBackground}" BorderBrush="{DynamicResource TitleBarBorder}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="7" Height="7" Background="{DynamicResource Primary}" CornerRadius="4" Margin="0,0,10,0" />
                    <TextBlock Text="X4 mod管理器" FontWeight="SemiBold" />
                    <TextBlock Text="  /  LOCAL EXTENSION CONTROL" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ThemeToggleButton" Content="☾  夜间" Height="47" Margin="0" Padding="14,0"
                            Background="Transparent" BorderThickness="0" Click="ThemeToggle_Click" />
                    <Button Content="—" Width="46" Height="47" Margin="0" Padding="0" Background="Transparent"
                            BorderThickness="0" FontSize="17" Click="Minimize_Click" />
                    <Button Content="□" Width="46" Height="47" Margin="0" Padding="0" Background="Transparent"
                            BorderThickness="0" FontSize="15" Click="Maximize_Click" />
                    <Button Content="×" Width="46" Height="47" Margin="0" Padding="0" Background="Transparent"
                            BorderThickness="0" FontSize="21" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource WindowBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
                <Grid Margin="16,28,16,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="76" Height="76" Background="#0C4870" BorderBrush="#28A9FF" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <TextBlock Text="X⁴" FontSize="35" FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="White" />
                                <Border Height="5" VerticalAlignment="Bottom" Background="#28A9FF" CornerRadius="0,0,12,12" />
                            </Grid>
                        </Border>
                        <TextBlock Text="X4 mod管理器" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="轻量 · 本地 · 可恢复" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Margin="0,5,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,38,0,0">
                        <Border Background="{DynamicResource ActiveNavBackground}" BorderBrush="{DynamicResource ActiveNavBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" Foreground="{DynamicResource Primary}" FontSize="18" Width="30" />
                                <TextBlock Text="MOD 管理" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button Content="↻  重新扫描" HorizontalContentAlignment="Left" Margin="0,10,0,0"
                                Background="Transparent" BorderThickness="0" Click="Refresh_Click" />
                        <Button Content="▣  选择游戏目录" HorizontalContentAlignment="Left" Margin="0,2,0,0"
                                Background="Transparent" BorderThickness="0" Click="ChooseGamePath_Click" />
                        <Button Content="≡  选择玩家配置" HorizontalContentAlignment="Left" Margin="0,2,0,0"
                                Background="Transparent" BorderThickness="0" Click="ChooseProfilePath_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="8,14,8,0">
                            <StackPanel>
                                <TextBlock Text="●  写入前自动备份" Foreground="{DynamicResource Success}" FontSize="12" />
                                <Button Content="退出" HorizontalContentAlignment="Left" Margin="0,8,0,0"
                                        Background="Transparent" BorderThickness="0" Click="Exit_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelOutline}" BorderThickness="1" CornerRadius="16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="2,0,2,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☷" Foreground="{DynamicResource Primary}" FontSize="19" Margin="0,0,10,0" />
                                <TextBlock Text="本地 MOD 列表" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox x:Name="SourceFilterComboBox" Grid.Column="1" Width="132" Height="34" Margin="0,0,12,0"
                                      SelectedValuePath="Tag" SelectionChanged="SourceFilter_SelectionChanged">
                                <ComboBoxItem Content="全部来源" Tag="all" IsSelected="True" />
                                <ComboBoxItem Content="创意工坊" Tag="workshop" />
                                <ComboBoxItem Content="Nexus Mods" Tag="nexus" />
                                <ComboBoxItem Content="本地安装" Tag="local" />
                                <ComboBoxItem Content="官方 DLC" Tag="official" />
                            </ComboBox>
                            <TextBlock x:Name="CountText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" Text="共 0 个扩展" />
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,0,0,10" />

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1" CornerRadius="7" Height="34">
                                    <Grid>
                                        <TextBlock x:Name="SearchPlaceholder" Text="⌕  搜索本地 MOD"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                                   Margin="10,0" IsHitTestVisible="False" />
                                        <TextBox x:Name="SearchTextBox" Background="Transparent" BorderThickness="0" Padding="10,5"
                                                 VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="2" Text="新建分类" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="NewFolderTextBox" Grid.Column="3" Height="34" Padding="8,5"
                                         ToolTip="输入分类名称" VerticalContentAlignment="Center" />
                                <Button Grid.Column="5" Content="＋" Margin="0" Padding="0" ToolTip="新建功能分类"
                                        Click="AddFolder_Click" />
                            </Grid>

                            <Grid Grid.Row="1" Background="{DynamicResource SidebarBackground}" Height="29">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="MOD 名称" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11" />
                                <TextBlock Grid.Column="3" Text="作者" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11" />
                                <TextBlock Grid.Column="4" Text="版本" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11" />
                                <TextBlock Grid.Column="5" Text="来源" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11" />
                                <TextBlock Grid.Column="6" Text="状态" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11" />
                            </Grid>

                            <ListBox x:Name="ModsGrid" Grid.Row="2" Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                                     BorderThickness="0" AllowDrop="True" SelectionMode="Extended"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="ModsGrid_SelectionChanged"
                                     PreviewMouseLeftButtonDown="ModsGrid_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="ModsGrid_PreviewMouseMove"
                                     PreviewDragOver="ModsGrid_PreviewDragOver" Drop="ModsGrid_Drop">
                                <ListBox.Resources>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <DataTemplate DataType="{x:Type local:ModCategoryRow}">
                                        <Border Background="{DynamicResource ActiveNavBackground}" BorderBrush="{DynamicResource ActiveNavBorder}"
                                                BorderThickness="0,1,0,1" Padding="8,5" Margin="0,5,0,2"
                                                AllowDrop="True" Cursor="Hand"
                                                MouseLeftButtonUp="CategoryHeader_MouseLeftButtonUp"
                                                DragOver="CategoryHeader_DragOver" Drop="CategoryHeader_Drop">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="删除分类" IsEnabled="{Binding CanDelete}" Click="DeleteFolder_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" Foreground="{DynamicResource Primary}" VerticalAlignment="Center"
                                                           Cursor="SizeAll" ToolTip="点击展开或收起；拖动可改变顺序" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondary}" FontSize="10"
                                                           VerticalAlignment="Center" Margin="8,0" Text="{Binding Count}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type models:ModInfo}">
                                        <Border x:Name="ModRow" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Divider}"
                                                BorderThickness="0,0,0,1" Padding="6,4" MinHeight="40">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="设置别名…" Click="SetAlias_Click" />
                                                    <MenuItem Header="清除别名" Click="ClearAlias_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="50" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="⋮⋮" Foreground="{DynamicResource DragHandle}" VerticalAlignment="Center"
                                                           Cursor="SizeAll" FontSize="10" ToolTip="拖动调整顺序或放入分类" />
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                                           ToolTip="{Binding Name}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Author}" Foreground="{DynamicResource TextSecondary}"
                                                           FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="4" Text="{Binding Version, StringFormat=v{0}}" Foreground="{DynamicResource TextSecondary}"
                                                           FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="5" Text="{Binding SourceText}" Foreground="{DynamicResource BadgeText}"
                                                           FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="6" Text="{Binding StateText}" Foreground="{DynamicResource TextSecondary}"
                                                           FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="ModRow" Property="Background" Value="{DynamicResource ItemHover}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="ModRow" Property="Background" Value="{DynamicResource ItemSelected}" />
                                                <Setter TargetName="ModRow" Property="BorderBrush" Value="{DynamicResource Primary}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.Resources>
                            </ListBox>
                        </Grid>

                        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{DynamicResource TextSecondary}"
                                   Margin="2,10,0,0" Text="准备就绪" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="2" Background="{DynamicResource WindowBackground}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelOutline}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="▶  配置控制" FontSize="16" FontWeight="SemiBold" />
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,13" />
                                <Button Content="▶  启动 X4" Background="{DynamicResource Primary}"
                                        BorderBrush="{DynamicResource Primary}" Margin="0,0,0,10" Padding="14,11"
                                        Click="LaunchGame_Click" />
                                <Button x:Name="ApplyButton" Content="应用更改" Background="{DynamicResource Primary}"
                                        BorderBrush="{DynamicResource Primary}" Margin="0,0,0,10" Padding="14,11" Click="Apply_Click" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="全部启用" Margin="0" Click="EnableAll_Click" />
                                    <Button Grid.Column="2" Content="全部禁用" Margin="0" Click="DisableAll_Click" />
                                </Grid>
                                <Button x:Name="RefreshButton" Content="↻  重新扫描" Margin="0,10,0,0" Click="Refresh_Click" />
                                <TextBlock Text="更改仅在应用后写入；请先关闭 X4。" Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" Margin="0,11,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelOutline}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="▣  安装信息" FontSize="16" FontWeight="SemiBold" />
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,13" />
                                <TextBlock x:Name="GameVersionText" Text="游戏版本：未检测" Foreground="{DynamicResource Primary}" />
                                <TextBlock Text="游戏目录" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,13,0,5" />
                                <TextBox x:Name="GamePathTextBox" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" />
                                <Button Content="选择游戏目录" Margin="0,8,0,0" Click="ChooseGamePath_Click" />
                                <TextBlock Text="玩家配置" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,13,0,5" />
                                <TextBox x:Name="ProfilePathTextBox" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" />
                                <Button Content="选择 content.xml" Margin="0,8,0,0" Click="ChooseProfilePath_Click" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelOutline}" BorderThickness="1" CornerRadius="16" Padding="18">
                            <StackPanel>
                                <TextBlock Text="●  MOD 信息" FontSize="16" FontWeight="SemiBold" />
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,13" />
                                <TextBlock x:Name="DetailNameText" Text="选择一个 MOD" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailMetaText" Foreground="{DynamicResource TextSecondary}" Margin="0,7,0,13" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailDescriptionText" Text="从左侧列表选择一个扩展以查看详情。"
                                           TextWrapping="Wrap" MaxHeight="150" Margin="0,0,0,12" LineHeight="19" />
                                <TextBlock x:Name="DetailPathText" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,13" FontSize="11" />
                                <Button x:Name="OpenSourceButton" Content="打开来源页" IsEnabled="False" Margin="0,0,0,8" Click="OpenSource_Click" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="TranslateButton" Content="翻译简介" IsEnabled="False" Margin="0" Click="Translate_Click" />
                                    <Button x:Name="OpenFolderButton" Grid.Column="2" Content="打开文件夹" IsEnabled="False" Margin="0" Click="OpenFolder_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
